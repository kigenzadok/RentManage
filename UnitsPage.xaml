<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:RentManage.Models"
             x:Class="RentManage.UnitsPage"
             Title="Units"
             BackgroundColor="#F8FAFC">

    <Grid>
        <Grid RowDefinitions="Auto, *">
            <!-- Form Card -->
            <Border x:Name="AddFormCard" 
                    Grid.Row="0" 
                    Margin="16,16,16,8" 
                    Padding="16" 
                    StrokeShape="RoundRectangle 16" 
                    StrokeThickness="0" 
                    BackgroundColor="White"
                    IsVisible="False">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.08" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Add Unit" FontSize="18" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center"/>
                        <Button Text="✕" Clicked="OnToggleAddFormClicked" BackgroundColor="Transparent" TextColor="#64748B" FontSize="16" HeightRequest="30" WidthRequest="30" Padding="0"/>
                    </Grid>

                    <Border StrokeShape="RoundRectangle 8" Stroke="#E2E8F0" Padding="10,0" BackgroundColor="#F8FAFC">
                        <Picker x:Name="PropertyPicker" 
                        Title="Select Property" 
                        ItemDisplayBinding="{Binding Name}" 
                        TextColor="#0F172A" />
                    </Border>

                    <Border StrokeShape="RoundRectangle 8" Stroke="#E2E8F0" Padding="10,0" BackgroundColor="#F8FAFC">
                        <Entry x:Name="UnitNumberEntry" Placeholder="Unit Number (e.g. A1)" />
                    </Border>

                    <!-- Renamed x:Name to MonthlyRentEntry to match UnitsPage.xaml.cs -->
                    <Border StrokeShape="RoundRectangle 8" Stroke="#E2E8F0" Padding="10,0" BackgroundColor="#F8FAFC">
                        <Entry x:Name="MonthlyRentEntry" Placeholder="Monthly Rent ($)" Keyboard="Numeric" />
                    </Border>

                    <Button Text="Save Unit" Clicked="OnSaveUnitClicked" Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Units List -->
            <Grid Grid.Row="1" RowDefinitions="Auto, *" Margin="16,8,16,16">
                <Label Grid.Row="0" Text="Property Units" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" Margin="4,0,0,8"/>

                <CollectionView Grid.Row="1" x:Name="UnitsListView">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Unit">
                            <Border Margin="0,0,0,10" Padding="14" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="White">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.04" />
                                </Border.Shadow>

                                <Grid ColumnDefinitions="*, Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding UnitNumber, StringFormat='Unit {0}'}" FontAttributes="Bold" FontSize="15" TextColor="#0F172A" />
                                        <Label Text="{Binding RentAmount, StringFormat='Rent: ${0:F2}/mo'}" FontSize="12" TextColor="#64748B" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding Status}" FontAttributes="Bold" FontSize="12" VerticalOptions="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>

        <!-- FAB Button -->
        <Button x:Name="FabButton"
                Text="+"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="White"
                BackgroundColor="#4F46E5"
                CornerRadius="28"
                HeightRequest="56"
                WidthRequest="56"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,20,24"
                Clicked="OnToggleAddFormClicked">
            <Button.Shadow>
                <Shadow Brush="#4F46E5" Offset="0,4" Radius="8" Opacity="0.4" />
            </Button.Shadow>
        </Button>
    </Grid>
</ContentPage>