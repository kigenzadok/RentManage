<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:RentManage.Models"
             x:Class="RentManage.UnitsPage"
             Title="Units">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Add New Unit" FontSize="20" FontAttributes="Bold"/>

            <Label Text="Select Property:" FontAttributes="Bold"/>
            <Picker x:Name="PropertyPicker" Title="Select Property" ItemDisplayBinding="{Binding Name}" />

            <Entry x:Name="UnitNumberEntry" Placeholder="Unit Number (e.g. Apt 101)" />
            <Entry x:Name="MonthlyRentEntry" Placeholder="Monthly Rent" Keyboard="Numeric" />

            <Button Text="Save Unit" Clicked="OnSaveUnitClicked" BackgroundColor="#2B0B98" TextColor="White"/>

            <BoxView HeightRequest="1" Color="Gray" Margin="0,10"/>

            <Label Text="All Units" FontSize="18" FontAttributes="Bold"/>

            <CollectionView x:Name="UnitsListView" HeightRequest="300">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Unit">
                        <Grid ColumnDefinitions="*,Auto" Padding="10" BackgroundColor="#F5F5F5" Margin="0,3">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding UnitNumber, StringFormat='Unit: {0}'}" FontAttributes="Bold" TextColor="Black"/>
                                <Label Text="{Binding Status, StringFormat='Status: {0}'}" FontSize="12" TextColor="Gray"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding MonthlyRent, StringFormat='${0:F2}'}" VerticalOptions="Center" FontAttributes="Bold" TextColor="Green"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>