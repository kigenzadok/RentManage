<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RentManage.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RentManage"
    Title="RentManage">

    <TabBar>
        <Tab Title="Properties" Icon="dotnet_bot.png">
            <ShellContent ContentTemplate="{DataTemplate local:PropertiesPage}" />
        </Tab>
        <Tab Title="Units" Icon="dotnet_bot.png">
            <ShellContent ContentTemplate="{DataTemplate local:UnitsPage}" />
        </Tab>
        <Tab Title="Register Tenant" Icon="dotnet_bot.png">
            <ShellContent ContentTemplate="{DataTemplate local:TenantsPage}" />
        </Tab>
    </TabBar>

</Shell>