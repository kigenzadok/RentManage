<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RentManage.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RentManage"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="White"
    Shell.TabBarForegroundColor="#4F46E5"
    Shell.TabBarUnselectedColor="#94A3B8"
    Shell.TabBarTitleColor="#4F46E5">

    <TabBar>
        <!-- 1. Dashboard -->
        <Tab Title="Dashboard" Icon="icon_dashboard.png">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
        </Tab>

        <!-- 2. Properties (Includes Units & Tenants as nested detail views) -->
        <Tab Title="Properties" Icon="icon_properties.png">
            <ShellContent ContentTemplate="{DataTemplate local:PropertiesPage}" Route="PropertiesPage" />
        </Tab>

        <!-- 3. Payments -->
        <Tab Title="Payments" Icon="icon_payments.png">
            <ShellContent ContentTemplate="{DataTemplate local:PaymentsPage}" Route="PaymentsPage" />
        </Tab>
        <Tab Title="Account" Icon="account.png">
            <ShellContent ContentTemplate="{DataTemplate local:ProfilePage}" Route="ProfilePage" />
        </Tab>
    </TabBar>

</Shell>