<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RentManage.ProfilePage"
             Title="Account &amp; Profile"
             BackgroundColor="#F8FAFC">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="16">

            <!-- Profile Header Card -->
            <Border StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="#4F46E5" Padding="20">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                    <Border StrokeShape="RoundRectangle 40" HeightRequest="80" WidthRequest="80" BackgroundColor="#6366F1" StrokeThickness="0" HorizontalOptions="Center">
                        <Label x:Name="AvatarInitialsLabel" Text="👤" FontSize="32" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White"/>
                    </Border>

                    <Label x:Name="HeaderNameLabel" Text="Account Profile" FontSize="20" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                    <Label x:Name="HeaderRoleLabel" Text="Select Role" FontSize="13" TextColor="#C7D2FE" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <!-- SECTION 1: Read-Only Details View (Shown after saving) -->
            <Border x:Name="ReadonlyProfileCard" StrokeShape="RoundRectangle 14" StrokeThickness="0" BackgroundColor="White" Padding="16" IsVisible="False">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.04"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Profile Details" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center"/>
                        <Button Grid.Column="1" Text="✏️ Edit" Clicked="OnEditProfileClicked" BackgroundColor="#EEF2FF" TextColor="#4F46E5" HeightRequest="36" Padding="12,0"/>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#F1F5F9" />

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Full Name" FontSize="11" TextColor="#64748B"/>
                        <Label x:Name="DisplayFullNameLabel" Text="-" FontSize="15" FontAttributes="Bold" TextColor="#0F172A"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Email Address" FontSize="11" TextColor="#64748B"/>
                        <Label x:Name="DisplayEmailLabel" Text="-" FontSize="15" TextColor="#0F172A"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Phone Number" FontSize="11" TextColor="#64748B"/>
                        <Label x:Name="DisplayPhoneLabel" Text="-" FontSize="15" TextColor="#0F172A"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Account Role" FontSize="11" TextColor="#64748B"/>
                        <Label x:Name="DisplayRoleLabel" Text="-" FontSize="15" FontAttributes="Bold" TextColor="#4F46E5"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- SECTION 2: Edit / Create Form (Hides after saving) -->
            <Border x:Name="EditProfileForm" StrokeShape="RoundRectangle 14" StrokeThickness="0" BackgroundColor="White" Padding="16" IsVisible="True">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.04"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="12">
                    <Label x:Name="FormTitleLabel" Text="Edit Details" FontSize="16" FontAttributes="Bold" TextColor="#0F172A"/>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Full Name" FontSize="12" TextColor="#64748B" FontAttributes="Bold"/>
                        <Border StrokeShape="RoundRectangle 8" Stroke="#E2E8F0" Padding="10,0" BackgroundColor="#F8FAFC">
                            <Entry x:Name="FullNameEntry" Placeholder="e.g. John Doe" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Email Address" FontSize="12" TextColor="#64748B" FontAttributes="Bold"/>
                        <Border StrokeShape="RoundRectangle 8" Stroke="#E2E8F0" Padding="10,0" BackgroundColor="#F8FAFC">
                            <Entry x:Name="EmailEntry" Placeholder="e.g. owner@rentmanage.com" Keyboard="Email" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Phone Number" FontSize="12" TextColor="#64748B" FontAttributes="Bold"/>
                        <Border StrokeShape="RoundRectangle 8" Stroke="#E2E8F0" Padding="10,0" BackgroundColor="#F8FAFC">
                            <Entry x:Name="PhoneEntry" Placeholder="e.g. +254 700 000000" Keyboard="Telephone" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Account Role" FontSize="12" TextColor="#64748B" FontAttributes="Bold"/>
                        <Border StrokeShape="RoundRectangle 8" Stroke="#E2E8F0" Padding="10,0" BackgroundColor="#F8FAFC">
                            <Picker x:Name="RolePicker" Title="Select Role" />
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,10,0,0">
                        <Button x:Name="CancelButton" Grid.Column="0" Text="Cancel" Clicked="OnCancelEditClicked" BackgroundColor="#F1F5F9" TextColor="#475569" HeightRequest="48" IsVisible="False"/>
                        <Button x:Name="SaveButton" Grid.Column="1" Text="Save Profile" Clicked="OnSaveProfileClicked" BackgroundColor="#4F46E5" TextColor="White" HeightRequest="48"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>