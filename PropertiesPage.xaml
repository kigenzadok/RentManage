<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:RentManage.Models"
             x:Class="RentManage.PropertiesPage"
             Title="Properties"
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto, *">
        <!-- Header Card -->
        <Border Grid.Row="0" Margin="16,16,16,8" Padding="16" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="White">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.05" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="10">
                <Label Text="Add Property" FontSize="18" FontAttributes="Bold" TextColor="#0F172A" />

                <Border StrokeShape="RoundRectangle 8" Stroke="#E2E8F0" Padding="10,0" BackgroundColor="#F8FAFC">
                    <Entry x:Name="PropertyNameEntry" Placeholder="Property Name (e.g., Sunset Heights)" />
                </Border>

                <Border StrokeShape="RoundRectangle 8" Stroke="#E2E8F0" Padding="10,0" BackgroundColor="#F8FAFC">
                    <Entry x:Name="PropertyAddressEntry" Placeholder="Address" />
                </Border>

                <Button Text="Save Property" Clicked="OnSavePropertyClicked" Margin="0,4,0,0" />
            </VerticalStackLayout>
        </Border>

        <!-- Properties List Section -->
        <Grid Grid.Row="1" RowDefinitions="Auto, *" Margin="16,8,16,16">
            <Label Grid.Row="0" Text="Registered Properties" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" Margin="4,0,0,8"/>

            <CollectionView Grid.Row="1" x:Name="PropertiesListView" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Padding="20">
                        <Label Text="No properties registered yet" TextColor="#94A3B8" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Property">
                        <Border Margin="0,0,0,10" Padding="16" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="White">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.04" />
                            </Border.Shadow>

                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" TextColor="#0F172A" />
                                    <Label Text="{Binding Address}" FontSize="13" TextColor="#64748B" />
                                </VerticalStackLayout>

                                <Border Grid.Column="1" StrokeShape="RoundRectangle 20" BackgroundColor="#EEF2FF" Padding="10,4" VerticalOptions="Center">
                                    <Label Text="Active" FontSize="11" FontAttributes="Bold" TextColor="#4F46E5" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>