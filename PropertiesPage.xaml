<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:RentManage.Models"
             x:Class="RentManage.PropertiesPage"
             Title="Properties"
             BackgroundColor="#F8FAFC">

    <Grid>
        <Grid RowDefinitions="Auto, *">
            <!-- Optional Add Property Form Card -->
            <Border x:Name="AddFormCard" 
                    Grid.Row="0" 
                    Margin="16,16,16,8" 
                    Padding="16" 
                    StrokeShape="RoundRectangle 16" 
                    StrokeThickness="0" 
                    BackgroundColor="White"
                    IsVisible="False">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.08" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Add Property" FontSize="18" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center"/>
                        <Button Text="✕" Clicked="OnToggleAddFormClicked" BackgroundColor="Transparent" TextColor="#64748B" FontSize="16" HeightRequest="30" WidthRequest="30" Padding="0"/>
                    </Grid>

                    <Border StrokeShape="RoundRectangle 8" Stroke="#E2E8F0" Padding="10,0" BackgroundColor="#F8FAFC">
                        <Entry x:Name="PropertyNameEntry" Placeholder="Property Name" />
                    </Border>

                    <Border StrokeShape="RoundRectangle 8" Stroke="#E2E8F0" Padding="10,0" BackgroundColor="#F8FAFC">
                        <Entry x:Name="PropertyAddressEntry" Placeholder="Address" />
                    </Border>

                    <Button Text="Save Property" Clicked="OnToggleAddFormClicked" Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Property List -->
            <Grid Grid.Row="1" RowDefinitions="Auto, *" Margin="16,8,16,16">
                <Label Grid.Row="0" Text="Registered Properties" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" Margin="4,0,0,8"/>

                <CollectionView Grid.Row="1" x:Name="PropertiesListView">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Property">
                            <Border Margin="0,0,0,10" Padding="14" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="White">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.04" />
                                </Border.Shadow>

                                <Grid RowDefinitions="Auto, Auto">
                                    <!-- Property Details -->
                                    <VerticalStackLayout Grid.Row="0" Spacing="2">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="15" TextColor="#0F172A" />
                                        <Label Text="{Binding Address}" FontSize="12" TextColor="#64748B" />
                                    </VerticalStackLayout>

                                    <!-- Quick Access Action Buttons -->
                                    <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="8" Margin="0,10,0,0">
                                        <Button Grid.Column="0" 
                                                Text="Units" 
                                                Clicked="OnViewUnitsClicked" 
                                                CommandParameter="{Binding .}" 
                                                BackgroundColor="#F1F5F9" 
                                                TextColor="#0F172A" 
                                                FontSize="12"
                                                HeightRequest="34" 
                                                CornerRadius="6" />

                                        <Button Grid.Column="1" 
                                                Text="Tenants" 
                                                Clicked="OnViewTenantsClicked" 
                                                CommandParameter="{Binding .}" 
                                                BackgroundColor="#F1F5F9" 
                                                TextColor="#0F172A" 
                                                FontSize="12"
                                                HeightRequest="34" 
                                                CornerRadius="6" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>

        <!-- Floating Action Button -->
        <Button x:Name="FabButton"
                Text="+"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="White"
                BackgroundColor="#4F46E5"
                CornerRadius="28"
                HeightRequest="56"
                WidthRequest="56"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,20,24"
                Clicked="OnToggleAddFormClicked">
            <Button.Shadow>
                <Shadow Brush="#4F46E5" Offset="0,4" Radius="8" Opacity="0.4" />
            </Button.Shadow>
        </Button>
    </Grid>
</ContentPage>