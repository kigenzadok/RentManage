<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RentManage.MainPage"
             Title="Dashboard"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Greeting Header -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Rental Overview" FontSize="24" FontAttributes="Bold" TextColor="#0F172A"/>
                <Label Text="Here is the performance summary of your portfolio." FontSize="14" TextColor="#64748B"/>
            </VerticalStackLayout>

            <!-- Revenue Banner Card -->
            <Border StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="#4F46E5" Padding="20">
                <Border.Shadow>
                    <Shadow Brush="#4F46E5" Offset="0,4" Radius="10" Opacity="0.3"/>
                </Border.Shadow>

                <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                        <Label Text="Monthly Projected Income" TextColor="#C7D2FE" FontSize="13" FontAttributes="Bold"/>
                        <Label x:Name="TotalRevenueLabel" Text="$0.00" TextColor="White" FontSize="28" FontAttributes="Bold"/>
                    </VerticalStackLayout>

                    <Border Grid.Row="0" Grid.Column="1" StrokeShape="RoundRectangle 12" BackgroundColor="#6366F1" Padding="12" VerticalOptions="Start">
                        <Label Text="💰" FontSize="20" HorizontalOptions="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- KPI Metric Grid (2x2) -->
            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="12" RowSpacing="12">

                <!-- Properties Count -->
                <Border Grid.Row="0" Grid.Column="0" StrokeShape="RoundRectangle 14" StrokeThickness="0" BackgroundColor="White" Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.04"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🏢 Properties" FontSize="12" FontAttributes="Bold" TextColor="#64748B"/>
                        <Label x:Name="TotalPropertiesLabel" Text="0" FontSize="22" FontAttributes="Bold" TextColor="#0F172A"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Total Units -->
                <Border Grid.Row="0" Grid.Column="1" StrokeShape="RoundRectangle 14" StrokeThickness="0" BackgroundColor="White" Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.04"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🔑 Total Units" FontSize="12" FontAttributes="Bold" TextColor="#64748B"/>
                        <Label x:Name="TotalUnitsLabel" Text="0" FontSize="22" FontAttributes="Bold" TextColor="#0F172A"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Occupancy Rate -->
                <Border Grid.Row="1" Grid.Column="0" StrokeShape="RoundRectangle 14" StrokeThickness="0" BackgroundColor="White" Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.04"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="📊 Occupancy Rate" FontSize="12" FontAttributes="Bold" TextColor="#64748B"/>
                        <Label x:Name="OccupancyRateLabel" Text="0%" FontSize="22" FontAttributes="Bold" TextColor="#059669"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Vacant Units -->
                <Border Grid.Row="1" Grid.Column="1" StrokeShape="RoundRectangle 14" StrokeThickness="0" BackgroundColor="White" Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.04"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🚪 Vacant Units" FontSize="12" FontAttributes="Bold" TextColor="#64748B"/>
                        <Label x:Name="VacantUnitsLabel" Text="0" FontSize="22" FontAttributes="Bold" TextColor="#D97706"/>
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <!-- Quick Navigation Shortcuts -->
            <Label Text="Quick Actions" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" Margin="0,10,0,-5"/>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                <Button Grid.Column="0" Text="+ Register Tenant" Clicked="OnNavToTenantsClicked" BackgroundColor="#4F46E5" TextColor="White" HeightRequest="48"/>
                <Button Grid.Column="1" Text="+ Add Property" Clicked="OnNavToPropertiesClicked" BackgroundColor="#1E293B" TextColor="White" HeightRequest="48"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>